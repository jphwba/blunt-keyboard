{
    "manufacturer": "Jenish",
    "keyboard_name": "blunt_keyboardpad",
    "maintainer": "jphwba",
    "bootloader": "rp2040",
    "diode_direction": "COL2ROW",
    "features": {
        "bootmagic": true,
        "extrakey": true,
        "mousekey": true,
        "nkro": true,
        "rgblight": true,
        "rgb_matrix": false
    },
    "matrix_pins": {
        "cols": ["GP1", "GP2", "GP3", "GP4"],
        "rows": ["GP5", "GP6", "GP7", "GP8", "GP9"]
    },
    "processor": "RP2040",
    "url": "https://github.com/jphwba/blunt-keyboard",
    "usb": {
        "device_version": "1.0.0",
        "pid": "0x0000",
        "vid": "0xFEED"
    },
    "rgblight": {
        "driver": "ws2812",
        "led_count": 4,
        "pin": "GP10",
        "led_map": [0, 1, 2, 3]
    },
    "layouts": {
        "LAYOUT_numpad_5x4": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0},
                {"matrix": [0, 1], "x": 1, "y": 0},
                {"matrix": [0, 2], "x": 2, "y": 0},
                {"matrix": [0, 3], "x": 3, "y": 0},
                {"matrix": [1, 0], "x": 0, "y": 1},
                {"matrix": [1, 1], "x": 1, "y": 1},
                {"matrix": [1, 2], "x": 2, "y": 1},
                {"matrix": [2, 0], "x": 0, "y": 2},
                {"matrix": [2, 1], "x": 1, "y": 2},
                {"matrix": [2, 2], "x": 2, "y": 2},
                {"matrix": [1, 3], "x": 3, "y": 1, "h": 2},
                {"matrix": [3, 0], "x": 0, "y": 3},
                {"matrix": [3, 1], "x": 1, "y": 3},
                {"matrix": [3, 2], "x": 2, "y": 3},
                {"matrix": [4, 0], "x": 0, "y": 4, "w": 2},
                {"matrix": [4, 2], "x": 2, "y": 4},
                {"matrix": [3, 3], "x": 3, "y": 3, "h": 2}
            ]
        }
    }
}